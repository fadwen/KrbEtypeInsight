# Pester / coverage output
coverage.xml
testResults.xml
*.trx

# Local assessment output - these contain real account names, SIDs and client
# addresses from whatever domain the module was run against, and must never be
# committed. See the Fixtures section of the README.
*.evtx
KrbEtypeReport*.html
KrbEtypeReport*.csv
KrbEtypeReport*.json

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# PlatyPS build intermediate. The Markdown under docs/ is the source and the
# packaged help is en-US/KrbEtypeInsight-Help.xml; maml/ is just the staging
# folder Export-MamlCommandHelp writes to on the way there.
maml/

# Update-MarkdownCommandHelp writes these next to the originals.
*.md.bak

# Publish staging tree. Build/Publish-Module.ps1 wipes and rebuilds this on every run;
# it holds only copies of files that are tracked elsewhere.
out/
